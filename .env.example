# =============================================================================
# HVAC System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# In CI/CD, these are generated automatically from GitLab Variables.
# =============================================================================

# --- Database ---
DB_NAME=hvac_db
DB_USERNAME=postgres
DB_PASSWORD=your-secure-db-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/hvac_db

# --- MQTT Broker ---
MOSQUITTO_HOST=trolley.proxy.rlwy.net
MOSQUITTO_PORT=26703
MOSQUITTO_USERNAME=generator-monitoring-system
MOSQUITTO_PASSWORD=your-mqtt-password

# --- JWT ---
JWT_SECRET=your-jwt-secret-key-min-64-chars
JWT_EXPIRATION=21600000

# --- Email (Gmail SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://live-ac.tech,https://www.live-ac.tech

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://api.live-ac.tech
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Domain ---
DOMAIN=live-ac.tech
API_DOMAIN=api.live-ac.tech
